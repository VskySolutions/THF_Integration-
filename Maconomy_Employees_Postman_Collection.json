{
	"info": {
		"_postman_id": "maconomy-employee-api-collection",
		"name": "Deltek Maconomy - Employees API",
		"description": "Postman collection to authenticate and retrieve employee records from Deltek Maconomy showemployeeshr container.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Maconomy Auth (Login)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"var token = pm.response.headers.get('Maconomy-Reconnect');",
							"if (token) {",
							"    pm.collectionVariables.set('maconomy_reconnect_token', token);",
							"    console.log('Saved Reconnect Token:', token);",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"auth": {
					"type": "basic",
					"basic": [
						{
							"key": "username",
							"value": "{{maconomy_username}}",
							"type": "string"
						},
						{
							"key": "password",
							"value": "{{maconomy_password}}",
							"type": "string"
						}
					]
				},
				"method": "GET",
				"header": [
					{
						"key": "Accept",
						"value": "application/vnd.deltek.maconomy.authentication+json; charset=utf-8; version=3.0",
						"type": "text"
					},
					{
						"key": "Maconomy-Authentication",
						"value": "X-Reconnect",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{maconomy_base_url}}/maconomy-api/auth/{{maconomy_shortname}}/login",
					"host": [
						"{{maconomy_base_url}}"
					],
					"path": [
						"maconomy-api",
						"auth",
						"{{maconomy_shortname}}",
						"login"
					]
				},
				"description": "Authenticates with Deltek Maconomy using Basic Auth and stores the `Maconomy-Reconnect` response header into the `maconomy_reconnect_token` variable."
			},
			"response": []
		},
		{
			"name": "2. Get Filtered Employees (showemployeeshr)",
			"request": {
				"auth": {
					"type": "noauth"
				},
				"method": "POST",
				"header": [
					{
						"key": "Accept",
						"value": "application/vnd.deltek.maconomy.containers+json; charset=utf-8; version=9.0",
						"type": "text"
					},
					{
						"key": "Content-Type",
						"value": "application/vnd.deltek.maconomy.containers+json; charset=UTF-8; version=9.0",
						"type": "text"
					},
					{
						"key": "Authorization",
						"value": "X-Reconnect {{maconomy_reconnect_token}}",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"restriction\": \"DateEmployed le currentDate() and (DateEndEmployment gt currentDate() or DateEndEmployment = date(nulldate))\",\n  \"fields\": [\n    \"blocked\",\n    \"companyname\",\n    \"country\",\n    \"dateemployed\",\n    \"dateendemployment\",\n    \"electronicmailaddress\",\n    \"employeenumber\",\n    \"initials\",\n    \"instancekey\",\n    \"name1\",\n    \"position\",\n    \"profileimage\",\n    \"vendornumber\",\n    \"name2\",\n    \"name3\",\n    \"zipcode\",\n    \"postaldistrict\",\n    \"superioremployee\",\n    \"entityname\",\n    \"specification4name\",\n    \"firstname\",\n    \"lastname\",\n    \"middlename\"\n  ],\n  \"limit\": 100,\n  \"offset\": 0\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{maconomy_base_url}}/maconomy-api/containers/{{maconomy_shortname}}/showemployeeshr/filter",
					"host": [
						"{{maconomy_base_url}}"
					],
					"path": [
						"maconomy-api",
						"containers",
						"{{maconomy_shortname}}",
						"showemployeeshr",
						"filter"
					]
				},
				"description": "Fetches active employee records from the `showemployeeshr` container using the reconnect token."
			},
			"response": []
		}
	],
	"variable": [
		{
			"key": "maconomy_base_url",
			"value": "https://thfmaconomy-d01.deltekenterprise.com",
			"type": "string"
		},
		{
			"key": "maconomy_shortname",
			"value": "thmasd01",
			"type": "string"
		},
		{
			"key": "maconomy_username",
			"value": "THF_Integration_User",
			"type": "string"
		},
		{
			"key": "maconomy_password",
			"value": "HU0c0WbafevBeQ",
			"type": "string"
		},
		{
			"key": "maconomy_reconnect_token",
			"value": "",
			"type": "string"
		}
	]
}
