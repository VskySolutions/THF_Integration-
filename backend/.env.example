APP_NAME=Falcon THF Integration Services
APP_ENV=development
API_V1_PREFIX=/api/v1
DOCS_ENABLED=true
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=falcon_thf
DATABASE_ECHO=false
# Use one or more comma-separated long random secrets.
API_KEYS=replace-with-a-long-random-secret

# Maconomy Configuration
MACONOMY_BASE_URL=http://localhost:8080
MACONOMY_SHORTNAME=Falcon
MACONOMY_USERNAME=admin
MACONOMY_PASSWORD=admin

# CaseWare Cloud Configuration
CASEWARE_CLOUD_BASE_URL=https://api.casewarecloud.com
CASEWARE_CLOUD_CLIENT_ID=replace-with-your-client-id
CASEWARE_CLOUD_CLIENT_SECRET=replace-with-your-client-secret
CASEWARE_CLOUD_LANGUAGE=en
